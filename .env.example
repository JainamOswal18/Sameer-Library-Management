# MongoDB connection string
# For local development: mongodb://localhost:27017/library
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/library

# Auth.js secret — generate a strong random string (min 32 characters)
# You can generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Public URL of the deployed app (optional in production on Vercel)
AUTH_URL=http://localhost:3000
